# Copy to .env and adjust. Run: cp .env.example .env

# Client-side API URL (baked into browser bundle — must be localhost)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Server-side API URL (Docker network, used in SSR/API routes)
API_INTERNAL_URL=http://api:3000

# NextAuth
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Host port for the container (internal port is 3001)
FRONTEND_PORT=3001
